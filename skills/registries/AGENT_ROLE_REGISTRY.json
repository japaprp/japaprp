{
  "schema_version": "1.0.0",
  "registry_id": "council-central-specialist-agent-roles",
  "project_id": "central-council",
  "status": "catalogued_not_runtime_active",
  "design_principles": [
    "Agent roles are execution profiles, not duplicate skills.",
    "The Router selects a role only when the task requires its specialization.",
    "Every role reuses existing Council Central skills.",
    "Roles default to read-only; scoped writes require an explicit task grant within Owner-approved boundaries.",
    "A role definition is not evidence that a runtime can instantiate or dispatch that agent."
  ],
  "default_permission_profile": {
    "mode": "read_only",
    "allowed": [
      "read_repository",
      "read_registered_evidence",
      "analyze",
      "run_safe_local_tests"
    ],
    "write_scope": "none_by_default",
    "may_request_scoped_write": true,
    "forbidden": [
      "merge",
      "deploy",
      "publish_external",
      "delete",
      "change_secrets",
      "change_permissions",
      "create_paid_resources",
      "cross_project_access"
    ]
  },
  "roles": [
    {
