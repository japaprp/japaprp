      "purpose": "Avaliar qualidade, precisão, completude, rastreabilidade e aderência aos critérios das saídas de agentes.",
      "primary_skill": "ai-integration-evaluation",
      "supporting_skills": [
        "testing-regression-quality",
        "agent-orchestration"
      ],
      "triggers": [
        "agent_output_review",
        "quality_scorecard",
        "independent_result_evaluation"
      ],
      "default_permission_profile": "read_only",
      "qa_independence_required": true
