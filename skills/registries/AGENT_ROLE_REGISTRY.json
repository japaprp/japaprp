  "runtime_binding": {
    "required": true,
    "adapter_contract": "skills/agent-orchestration/AGENT_RUNTIME_ADAPTER_CONTRACT.md",
    "required_operations": [
      "discover_runtime",
      "inspect_capabilities",
      "dispatch_child_agent",
      "get_task_status",
      "cancel_task",
      "collect_execution_receipt"
    ],
    "required_receipt_fields": [
      "task_id",
      "project_id",
      "role_id",
      "runtime_id",
      "agent_instance_id",
      "context_id",
      "started_at",
      "ended_at",
      "status",
      "input_digest",
      "output_digest",
      "tool_trace_ref"
    ],
    "activation_status": "not_verified",
    "rule": "Do not mark any role active until an actual runtime dispatch and independently verified receipt exist."
  },
  "runtime_candidates": [
    {
      "runtime_id": "openai-agents-api",
      "name": "OpenAI Agents API (managed Codex harness)",
      "status": "research_candidate_not_integrated",
      "evidence_urls": [
        "https://developers.openai.com/api/docs/guides/agents-api/multi-agent",
        "https://developers.openai.com/api/docs/guides/agents-api/overview",
        "https://developers.openai.com/api/docs/guides/agents-api/observability"
      ],
      "verified_capabilities": [
        "real_child_agent_dispatch",
        "independent_subagent_contexts",
        "parallel_execution",
        "subagent_event_stream",
        "session_history_and_trace_inspection",
        "self_hosted_environment_option"
      ],
      "constraints": [
        "requires an OpenAI API key",
        "model usage is billed at selected API rates",
        "hosted sandbox and tool usage may add costs",
        "subagents inherit configured MCP tools and credentials; least-privilege tool configuration is mandatory"
      ],
      "approval_gate": "Do not create/configure an API key, start a session, enable paid usage, or provision an environment without explicit Owner approval.",
      "adoption_gate": "Implement a small isolated proof of concept only after Owner approves API usage and budget; verify receipts, context isolation, cancellation, project isolation and approval boundaries before operational status."
    }
  ]
}
